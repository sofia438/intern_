# Copy this file to .env and fill in real values.

DATABASE_URL="postgresql://user:password@localhost:5432/globalexpo?schema=public"
SESSION_SECRET="generate-with-openssl-rand-base64-32"
RESEND_API_KEY="re_xxx"
EMAIL_FROM="GlobalExpo <onboarding@yourdomain.com>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
IPINFO_TOKEN="get-a-free-token-at-ipinfo.io"

# Register this exact redirect URI in Google Cloud Console: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxx"

GROQ_API_KEY="get-from-console.groq.com"
GROQ_CHAT_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="llama-3.2-90b-vision-preview"

# Serper.dev for AI Lead Finder Google search: https://serper.dev/api-key
SERPER_API_KEY="get-from-serper.dev"

# SerpApi for AI Lead Finder Bing/Yandex search: https://serpapi.com/manage-api-key
SERPAPI_API_KEY="get-from-serpapi.com"
